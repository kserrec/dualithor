  [
    "mirage-crypto-pk.2.3.0"
    "git+https://github.com/mirage/mirage-crypto.git#00ed1238df988c6c109c753cedb87388d352a60c"
  ]
  [
    "mirage-crypto-ec.2.3.0"
    "git+https://github.com/mirage/mirage-crypto.git#00ed1238df988c6c109c753cedb87388d352a60c"
  ]
]
