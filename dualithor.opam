# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "A proof-producing logic programming language based on term logic (TFL)"
maintainer: ["Kyle Serrecchia <kserrec@gmail.com>"]
authors: ["Kyle Serrecchia <kserrec@gmail.com>"]
license: "MIT"
homepage: "https://github.com/kserrec/dualithor"
bug-reports: "https://github.com/kserrec/dualithor/issues"
depends: [
  "ocaml" {>= "4.14.4" & < "5.0"}
  "dune" {>= "3.6"}
  "qcheck-core" {with-test}
  "yojson"
  "lwt" {with-test}
  "cohttp-lwt-unix" {with-test}
  "tls-lwt" {with-test}
  "mirage-crypto" {with-test & >= "2.3.0"}
  "mirage-crypto-rng" {with-test & >= "2.3.0"}
  "mirage-crypto-pk" {with-test & >= "2.3.0"}
  "mirage-crypto-ec" {with-test & >= "2.3.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/kserrec/dualithor.git"
# Dualithor's retained development-only translation tests require Mirage Crypto
# 2.3.0, which fixes OSEC-2026-14 and OSEC-2026-15 but was not yet in the
# official opam index when this floor landed. All four packages come from one
# release and constrain one another to the exact version, so pin the whole set
# to the peeled v2.3.0 commit. Remove these pins once 2.3.0 is indexed; keep the
# test-only >= 2.3.0 dependency floors in dune-project. A normal Dualithor install
# does not select this network/TLS graph.
pin-depends: [
  [
    "mirage-crypto.2.3.0"
    "git+https://github.com/mirage/mirage-crypto.git#00ed1238df988c6c109c753cedb87388d352a60c"
  ]
  [
    "mirage-crypto-rng.2.3.0"
    "git+https://github.com/mirage/mirage-crypto.git#00ed1238df988c6c109c753cedb87388d352a60c"
  ]
  [
    "mirage-crypto-pk.2.3.0"
    "git+https://github.com/mirage/mirage-crypto.git#00ed1238df988c6c109c753cedb87388d352a60c"
  ]
  [
    "mirage-crypto-ec.2.3.0"
    "git+https://github.com/mirage/mirage-crypto.git#00ed1238df988c6c109c753cedb87388d352a60c"
  ]
]
