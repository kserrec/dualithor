{
  "contract": "core-0.1",
  "cases": [
    {
      "id": "categorical-barbara",
      "rule": "Complete P/Z closure over level-0 atomic categorical A propositions",
      "focus": "-S+P",
      "operation": {
        "kind": "argument",
        "premises": ["-M+P", "-S+M"],
        "conclusion": "-S+P"
      },
      "expected": {
        "printed": "−S+P",
        "canonical": "−S+P",
        "reading": "every s is p",
        "result": "valid",
        "method": "PZ",
        "complete": true,
        "proof": {"kind": "certificate", "rules": [], "final": null}
      }
    },
    {
      "id": "universal-has-no-existential-import",
      "rule": "A universal premise does not establish a particular conclusion",
      "focus": "-A+B",
      "operation": {
        "kind": "argument",
        "premises": ["-A+B"],
        "conclusion": "+A+B"
      },
      "expected": {
        "printed": "−A+B",
        "canonical": "−A+B",
        "reading": "every a is b",
        "result": "invalid",
        "method": "PZ",
        "complete": true,
        "proof": {"kind": "none", "rules": [], "final": null}
      }
    },
    {
      "id": "premise-free-tautology-explanation",
      "rule": "A proof with no given lines reads as a sentence without an empty Because clause",
      "focus": "-(+A+B)+(+A+B)",
      "operation": {
        "kind": "argument",
        "premises": [],
        "conclusion": "-(+A+B)+(+A+B)"
      },
      "expected": {
        "printed": "−(+A+B)+(+A+B)",
        "canonical": "−(+A+B)+(+A+B)",
        "reading": "every a b is a b",
        "result": "valid",
        "method": "derivation",
        "complete": false,
        "proof": {
          "kind": "direct",
          "rules": ["It"],
          "final": "−(+A+B)+(+A+B)",
          "explanation": "Every a b is a b."
        }
      }
    },
    {
      "id": "fixed-reference-wild-quantity",
      "rule": "A starred singular is a fixed reference whose universal and particular readings coincide",
      "focus": "+-Socrates*+Man",
      "operation": {
        "kind": "argument",
        "premises": ["+-Socrates*+Man", "-Man+Mortal"],
        "conclusion": "+-Socrates*+Mortal"
      },
      "expected": {
        "printed": "±Socrates*+Man",
        "canonical": "+Man+Socrates*",
        "reading": "Socrates is a man",
        "result": "valid",
        "method": "PZ",
        "complete": true,
        "proof": {"kind": "certificate", "rules": [], "final": null}
      }
    },
    {
      "id": "quoted-star-is-not-a-singular-marker",
      "rule": "A star inside a quoted general name remains name content and is distinct from a trailing singular marker",
      "focus": "+\"A*\"+P",
      "operation": {
        "kind": "argument",
        "premises": ["+\"A*\"+P"],
        "conclusion": "+A*+P"
      },
      "expected": {
        "printed": "+\"A*\"+P",
        "canonical": "+\"A*\"+P",
        "reading": "some a* is p",
        "result": "invalid",
        "method": "PZ",
        "complete": true,
        "proof": {"kind": "none", "rules": [], "final": null}
      }
    },
    {
      "id": "compound-dictum-de-omni",
      "rule": "A compound is one term and DON substitutes a universal classification at its positive occurrence",
      "focus": "-(+White+Horse)+Gentle",
      "operation": {
        "kind": "argument",
        "premises": ["+Knight+(+White+Horse)", "-(+White+Horse)+Gentle"],
        "conclusion": "+Knight+Gentle"
      },
      "expected": {
        "printed": "−(+White+Horse)+Gentle",
        "canonical": "−(+Horse+White)+Gentle",
        "reading": "every white horse is gentle",
        "result": "valid",
        "method": "derivation",
        "complete": false,
        "proof": {
          "kind": "direct",
          "rules": ["premise", "premise", "DON"],
          "final": "+Gentle+Knight"
        }
      }
    },
    {
      "id": "relational-object-substitution",
      "rule": "DON reaches a positive relational object without reversing relation orientation",
      "focus": "+S+(Lov+Girl)",
      "operation": {
        "kind": "argument",
        "premises": ["+S+(Lov+Girl)", "-Girl+Human"],
        "conclusion": "+S+(Lov+Human)"
      },
      "expected": {
        "printed": "+S+(Lov+Girl)",
        "canonical": "+(Lov+Girl)+S",
        "reading": "some s lov some girl",
        "result": "valid",
        "method": "derivation",
        "complete": false,
        "proof": {
          "kind": "direct",
          "rules": ["premise", "premise", "DON"],
          "final": "+(Lov+Human)+S"
        }
      }
    },
    {
      "id": "relational-contradicted",
      "rule": "A proved contradictory yields contradicted after the requested non-atomic conclusion is not proved",
      "focus": "-S-(Lov+Human)",
      "operation": {
        "kind": "argument",
        "premises": ["+S+(Lov+Girl)", "-Girl+Human"],
        "conclusion": "-S-(Lov+Human)"
      },
      "expected": {
        "printed": "−S−(Lov+Human)",
        "canonical": "−(Lov+Human)−S",
        "reading": "no s lov some human",
        "result": "contradicted",
        "method": "derivation",
        "complete": false,
        "proof": {
          "kind": "direct-contradictory",
          "rules": ["premise", "premise", "DON"],
          "final": "+(Lov+Human)+S"
        }
      }
    },
    {
      "id": "relational-search-abstains",
      "rule": "Failure of bounded non-atomic search is unknown rather than invalid",
      "focus": "+Girl+Coward",
      "operation": {
        "kind": "argument",
        "premises": ["+Boy+(Lov+Girl)", "-Boy-(Lov+Coward)"],
        "conclusion": "+Girl+Coward"
      },
      "expected": {
        "printed": "+Girl+Coward",
        "canonical": "+Coward+Girl",
        "reading": "some girl is coward",
        "result": "unknown",
        "method": "derivation",
        "complete": false,
        "proof": {"kind": "none", "rules": [], "final": null}
      }
    },
    {
      "id": "numerical-sufficient-condition",
      "rule": "A levelled atomic argument is valid when all three numerical conditions hold",
      "focus": "+C^3-H",
      "operation": {
        "kind": "argument",
        "premises": ["+C^3-H", "-C+E"],
        "conclusion": "+E-H"
      },
      "expected": {
        "printed": "+C³−H",
        "canonical": "+C−H",
        "reading": "few c is h",
        "result": "valid",
        "method": "numerical",
        "complete": false,
        "proof": {"kind": "numerical-decision", "rules": [], "final": null}
      }
    },
    {
      "id": "numerical-failure-abstains",
      "rule": "Failure of a numerical sufficient condition is unknown rather than invalid",
      "focus": "+S^2+P",
      "operation": {
        "kind": "argument",
        "premises": ["+S^2+P", "+S^2+Q"],
        "conclusion": "+P+Q"
      },
      "expected": {
        "printed": "+S²+P",
        "canonical": "+P+S",
        "reading": "most s is p",
        "result": "unknown",
        "method": "numerical",
        "complete": false,
        "proof": {"kind": "numerical-decision", "rules": [], "final": null}
      }
    },
    {
      "id": "nested-numerical-level-is-refused",
      "rule": "A numerical level inside a proposition term routes before level-less canonicalization and is refused outside the atomic numerical fragment",
      "focus": "+[+p^2+q]+r",
      "operation": {
        "kind": "argument-error",
        "premises": ["+[+p^2+q]+r"],
        "conclusion": "+[+p+q]+r"
      },
      "expected": {
        "printed": "+[+p²+q]+r",
        "canonical": "+[+p+q]+r",
        "reading": "some “most p is q” is r",
        "result": "outside_fragment",
        "message": "quantity levels are supported only in categorical (atomic) syllogisms",
        "where": "argument",
        "method": null,
        "complete": false,
        "proof": {"kind": "none", "rules": [], "final": null}
      }
    },
    {
      "id": "levelled-subject-with-fixed-predicate-reading",
      "rule": "A fixed predicate does not license conversion that would erase a numerical subject quantity",
      "focus": "+Man^2+Socrates*",
      "operation": {
        "kind": "argument",
        "premises": ["+Man^2+Socrates*"],
        "conclusion": "+Man^2+Socrates*"
      },
      "expected": {
        "printed": "+Man²+Socrates*",
        "canonical": "+Man+Socrates*",
        "reading": "most man is Socrates",
        "result": "valid",
        "method": "numerical",
        "complete": false,
        "proof": {"kind": "numerical-decision", "rules": [], "final": null}
      }
    },
    {
      "id": "program-ground-query-yes",
      "rule": "Programs ignore comments and a complete atomic ground query can establish support",
      "focus": "+-Socrates*+Mortal",
      "operation": {
        "kind": "ground-query",
        "program": "-- fixed individuals\n+-Socrates*+Man\n+-Fido*+Dog\n\n-Man+Animal -- classifications\n-Dog+Animal\n-Man+Mortal\n",
        "query": "+-Socrates*+Mortal"
      },
      "expected": {
        "printed": "±Socrates*+Mortal",
        "canonical": "+Mortal+Socrates*",
        "reading": "Socrates is a mortal",
        "result": "yes",
        "method": "PZ",
        "complete": true,
        "proof": {"kind": "certificate", "rules": [], "final": null}
      }
    },
    {
      "id": "program-ground-query-no",
      "rule": "A complete atomic ground query returns no when the contradictory is supported",
      "focus": "+-Socrates*-Animal",
      "operation": {
        "kind": "ground-query",
        "program": "+-Socrates*+Man\n-Man+Animal\n",
        "query": "+-Socrates*-Animal"
      },
      "expected": {
        "printed": "±Socrates*−Animal",
        "canonical": "−Animal−Socrates*",
        "reading": "Socrates is not an animal",
        "result": "no",
        "method": "PZ",
        "complete": true,
        "proof": {"kind": "certificate", "rules": [], "final": null}
      }
    },
    {
      "id": "program-ground-query-numerical-no",
      "rule": "A numerical ground query returns no when the numerical procedure supports its contradictory",
      "focus": "-E+H",
      "operation": {
        "kind": "ground-query",
        "program": "+C^3-H\n-C+E\n",
        "query": "-E+H"
      },
      "expected": {
        "printed": "−E+H",
        "canonical": "−E+H",
        "reading": "every e is h",
        "result": "no",
        "method": "numerical",
        "complete": false,
        "proof": {"kind": "numerical-decision", "rules": [], "final": null}
      }
    },
    {
      "id": "program-ground-query-open-world-neither",
      "rule": "Atomic ground-query unknown can completely establish that neither side follows",
      "focus": "+-Fido*+Mortal",
      "operation": {
        "kind": "ground-query",
        "program": "+-Fido*+Dog\n-Dog+Animal\n-Man+Mortal\n",
        "query": "+-Fido*+Mortal"
      },
      "expected": {
        "printed": "±Fido*+Mortal",
        "canonical": "±Fido*+Mortal",
        "reading": "Fido is a mortal",
        "result": "unknown",
        "method": null,
        "complete": true,
        "proof": {"kind": "none", "rules": [], "final": null}
      }
    },
    {
      "id": "program-ground-query-search-unknown",
      "rule": "Non-atomic ground-query unknown retains bounded-search incompleteness",
      "focus": "+Girl+Coward",
      "operation": {
        "kind": "ground-query",
        "program": "+Boy+(Lov+Girl)\n-Boy-(Lov+Coward)\n",
        "query": "+Girl+Coward"
      },
      "expected": {
        "printed": "+Girl+Coward",
        "canonical": "+Coward+Girl",
        "reading": "some girl is coward",
        "result": "unknown",
        "method": null,
        "complete": false,
        "proof": {"kind": "none", "rules": [], "final": null}
      }
    },
    {
      "id": "term-description-query",
      "rule": "A bounded term query returns strongest supported descriptions in deterministic order",
      "focus": "+-Socrates*+Man",
      "operation": {
        "kind": "term-query",
        "program": "+-Socrates*+Man\n-Man+Animal\n-Man+Mortal\n",
        "term": "Socrates*"
      },
      "expected": {
        "printed": "±Socrates*+Man",
        "canonical": "+Man+Socrates*",
        "reading": "Socrates is a man",
        "result": ["±Socrates*+Animal", "±Socrates*+Man", "±Socrates*+Mortal"],
        "method": "bounded-saturation",
        "complete": false,
        "proof": {"kind": "not-exposed", "rules": [], "final": null}
      }
    },
    {
      "id": "atomic-program-inconsistency",
      "rule": "Atomic consistency closure is complete and an inconsistency carries a refutation",
      "focus": "+-Socrates*-Mortal",
      "operation": {
        "kind": "consistency",
        "program": "+-Socrates*+Man\n-Man+Mortal\n+-Socrates*-Mortal\n"
      },
      "expected": {
        "printed": "±Socrates*−Mortal",
        "canonical": "−Mortal−Socrates*",
        "reading": "Socrates is not a mortal",
        "result": "inconsistent",
        "method": "PZ",
        "complete": true,
        "proof": {
          "kind": "refutation",
          "rules": ["fact", "fact", "fact", "DON", "contradiction"],
          "final": "⊥"
        }
      }
    },
    {
      "id": "non-atomic-consistency-abstains",
      "rule": "A failed non-atomic refutation search does not establish consistency",
      "focus": "+Boy+(Lov+Girl)",
      "operation": {
        "kind": "consistency",
        "program": "+Boy+(Lov+Girl)\n"
      },
      "expected": {
        "printed": "+Boy+(Lov+Girl)",
        "canonical": "+(Lov+Girl)+Boy",
        "reading": "some boy lov some girl",
        "result": "no-contradiction-found",
        "method": "refutation-search",
        "complete": false,
        "proof": {"kind": "none", "rules": [], "final": null}
      }
    },
    {
      "id": "rewrite-equivalence-witness",
      "rule": "Contraposition supplies a sound rewrite witness without making rewrite failure complete",
      "focus": "-Dog+Mammal",
      "operation": {
        "kind": "equivalence",
        "left": "-Dog+Mammal",
        "right": "-(−Mammal)+(−Dog)"
      },
      "expected": {
        "printed": "−Dog+Mammal",
        "canonical": "−Dog+Mammal",
        "reading": "every dog is mammal",
        "result": true,
        "method": "rewrite",
        "complete": false,
        "proof": {"kind": "rewrite-path", "rules": ["contrapositive"], "final": null}
      }
    },
    {
      "id": "propositional-term-truth-table-equivalence",
      "rule": "Eligible propositional terms receive complete one-member truth-table equivalence semantics",
      "focus": "-[p]+[q]",
      "operation": {
        "kind": "equivalence",
        "left": "-[p]+[q]",
        "right": "-p+q"
      },
      "expected": {
        "printed": "−[p]+[q]",
        "canonical": "−[p]+[q]",
        "reading": "every p is q",
        "result": true,
        "method": "dnf",
        "complete": true,
        "proof": {"kind": "truth-table", "rules": [], "final": null}
      }
    },
    {
      "id": "equivalence-truth-table-union-cap",
      "rule": "Truth-table equivalence is complete only when the union contains at most sixteen atoms; larger unions use bounded rewrite search",
      "focus": "+(+a+b+c+d+e+f+g+h)+i",
      "operation": {
        "kind": "equivalence",
        "left": "+(+a+b+c+d+e+f+g+h)+i",
        "right": "+(+j+k+l+m+n+o+p)+q"
      },
      "expected": {
        "printed": "+(+a+b+c+d+e+f+g+h)+i",
        "canonical": "+(+a+b+c+d+e+f+g+h)+i",
        "reading": "some a b c d e f g h is i",
        "result": false,
        "method": "rewrite",
        "complete": false,
        "proof": {"kind": "none", "rules": [], "final": null}
      }
    },
    {
      "id": "quoted-name-terminal-control-refusal",
      "rule": "Quoted names refuse terminal controls and bidirectional formatting controls before any human-facing rendering",
      "focus": "-S+P",
      "operation": {
        "kind": "argument-error",
        "premises": ["+\"safe\u001b[31m\"+P"],
        "conclusion": "-S+P"
      },
      "expected": {
        "printed": "−S+P",
        "canonical": "−S+P",
        "reading": "every s is p",
        "result": "lexical",
        "message": "Control and bidirectional formatting characters are not allowed in quoted terms (at position 6)",
        "where": "premise 1",
        "method": null,
        "complete": false,
        "proof": {"kind": "none", "rules": [], "final": null}
      }
    },
    {
      "id": "equivalence-dnf-output-budget",
      "rule": "A sixteen-atom truth table uses bounded rewrite search when materializing its DNF would exceed the core output budget",
      "focus": "−(+p00000+p00001+p00002+p00003+p00004+p00005+p00006+p00007+p00008+p00009+p00010+p00011+p00012+p00013+p00014+p00015)+(+p00000+p00001+p00002+p00003+p00004+p00005+p00006+p00007+p00008+p00009+p00010+p00011+p00012+p00013+p00014+p00015)",
      "operation": {
        "kind": "equivalence",
        "left": "−(+p00000+p00001+p00002+p00003+p00004+p00005+p00006+p00007+p00008+p00009+p00010+p00011+p00012+p00013+p00014+p00015)+(+p00000+p00001+p00002+p00003+p00004+p00005+p00006+p00007+p00008+p00009+p00010+p00011+p00012+p00013+p00014+p00015)",
        "right": "−(+p00000+p00001+p00002+p00003+p00004+p00005+p00006+p00007+p00008+p00009+p00010+p00011+p00012+p00013+p00014+p00015)+(+p00000+p00001+p00002+p00003+p00004+p00005+p00006+p00007+p00008+p00009+p00010+p00011+p00012+p00013+p00014+p00015)"
      },
      "expected": {
        "printed": "−(+p00000+p00001+p00002+p00003+p00004+p00005+p00006+p00007+p00008+p00009+p00010+p00011+p00012+p00013+p00014+p00015)+(+p00000+p00001+p00002+p00003+p00004+p00005+p00006+p00007+p00008+p00009+p00010+p00011+p00012+p00013+p00014+p00015)",
        "canonical": "−(+p00000+p00001+p00002+p00003+p00004+p00005+p00006+p00007+p00008+p00009+p00010+p00011+p00012+p00013+p00014+p00015)+(+p00000+p00001+p00002+p00003+p00004+p00005+p00006+p00007+p00008+p00009+p00010+p00011+p00012+p00013+p00014+p00015)",
        "reading": "every p00000 p00001 p00002 p00003 p00004 p00005 p00006 p00007 p00008 p00009 p00010 p00011 p00012 p00013 p00014 p00015 is p00000 p00001 p00002 p00003 p00004 p00005 p00006 p00007 p00008 p00009 p00010 p00011 p00012 p00013 p00014 p00015",
        "result": true,
        "method": "rewrite",
        "complete": false,
        "proof": {"kind": "rewrite-path", "rules": [], "final": null}
      }
    }
  ]
}
