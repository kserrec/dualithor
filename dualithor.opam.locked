opam-version: "2.0"
name: "dualithor"
version: "dev"
synopsis:
  "A proof-producing logic programming language based on term logic (TFL)"
maintainer: "Kyle Serrecchia <kserrec@gmail.com>"
authors: "Kyle Serrecchia <kserrec@gmail.com>"
license: "MIT"
homepage: "https://github.com/kserrec/dualithor"
bug-reports: "https://github.com/kserrec/dualithor/issues"
depends: [
  "angstrom" {= "0.16.1" & with-test}
  "asn1-combinators" {= "0.3.2" & with-test}
  "astring" {= "0.8.5" & with-test}
  "base" {= "v0.16.5" & with-test}
  "base-bigarray" {= "base"}
  "base-bytes" {= "base" & with-test}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "base64" {= "3.5.2" & with-test}
  "bigstringaf" {= "0.10.0" & with-test}
  "bos" {= "0.3.0" & with-test}
  "ca-certs" {= "1.0.3" & with-test}
  "cmdliner" {= "2.1.1" & with-test}
  "cohttp" {= "6.2.2" & with-test}
  "cohttp-lwt" {= "6.2.2" & with-test}
  "cohttp-lwt-unix" {= "6.2.2" & with-test}
  "conduit" {= "8.0.0" & with-test}
  "conduit-lwt" {= "8.0.0" & with-test}
  "conduit-lwt-unix" {= "8.0.0" & with-test}
  "conf-gmp" {= "5" & with-test}
  "conf-gmp-powm-sec" {= "4" & with-test}
  "conf-pkg-config" {= "5" & with-test}
  "cppo" {= "1.8.0" & with-test}
  "csexp" {= "1.5.2" & with-test}
  "digestif" {= "1.3.1" & with-test}
  "domain-name" {= "0.5.0" & with-test}
  "dune" {= "3.24.2"}
  "dune-configurator" {= "3.24.2" & with-test}
  "duration" {= "0.3.1" & with-test}
  "eqaf" {= "0.10" & with-test}
  "fmt" {= "0.11.0" & with-test}
  "fpath" {= "0.7.3" & with-test}
  "gmap" {= "0.3.0" & with-test}
  "http" {= "6.2.2" & with-test}
  "ipaddr" {= "5.6.2" & with-test}
  "ipaddr-sexp" {= "5.6.2" & with-test}
  "kdf" {= "1.1.0" & with-test}
  "logs" {= "0.10.0" & with-test}
  "lwt" {= "6.1.2" & with-test}
  "macaddr" {= "5.6.2" & with-test}
  "magic-mime" {= "1.3.1" & with-test}
  "mirage-crypto" {= "2.3.0" & with-test}
  "mirage-crypto-ec" {= "2.3.0" & with-test}
  "mirage-crypto-pk" {= "2.3.0" & with-test}
  "mirage-crypto-rng" {= "2.3.0" & with-test}
  "ocaml" {= "4.14.4"}
  "ocaml-base-compiler" {= "4.14.4"}
  "ocaml-compiler-libs" {= "v0.12.4" & with-test}
  "ocaml-config" {= "2"}
  "ocaml-options-vanilla" {= "1"}
  "ocaml-syntax-shims" {= "1.0.0" & with-test}
  "ocamlbuild" {= "0.16.1" & with-test}
  "ocamlfind" {= "1.9.8" & with-test}
  "ocplib-endian" {= "1.2" & with-test}
  "ohex" {= "0.2.0" & with-test}
  "ppx_derivers" {= "1.2.1" & with-test}
  "ppx_sexp_conv" {= "v0.16.0" & with-test}
  "ppxlib" {= "0.35.0" & with-test}
  "ptime" {= "1.2.0" & with-test}
  "qcheck-core" {= "0.91" & with-test}
  "re" {= "1.14.0" & with-test}
  "rresult" {= "0.7.0" & with-test}
  "sexplib0" {= "v0.16.0" & with-test}
  "stdlib-shims" {= "0.3.0" & with-test}
  "stringext" {= "1.6.0" & with-test}
  "tls" {= "2.1.2" & with-test}
  "tls-lwt" {= "2.1.2" & with-test}
  "topkg" {= "1.1.1" & with-test}
  "uri" {= "4.4.0" & with-test}
  "uri-sexp" {= "4.4.0" & with-test}
  "x509" {= "1.1.1" & with-test}
  "yojson" {= "3.0.0"}
  "zarith" {= "1.14" & with-test}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/kserrec/dualithor.git"
pin-depends: [
  [
    "mirage-crypto.2.3.0"
    "git+https://github.com/mirage/mirage-crypto.git#00ed1238df988c6c109c753cedb87388d352a60c"
  ]
  [
    "mirage-crypto-ec.2.3.0"
    "git+https://github.com/mirage/mirage-crypto.git#00ed1238df988c6c109c753cedb87388d352a60c"
  ]
  [
    "mirage-crypto-pk.2.3.0"
    "git+https://github.com/mirage/mirage-crypto.git#00ed1238df988c6c109c753cedb87388d352a60c"
  ]
  [
    "mirage-crypto-rng.2.3.0"
    "git+https://github.com/mirage/mirage-crypto.git#00ed1238df988c6c109c753cedb87388d352a60c"
  ]
]
