(library
 (name bench)
 (modules score cfr)
 (libraries tfl tfl_verify))

; The 4.5b fidelity run: sends the gold set through every model and grades it.
; Spends real money on a cache miss; run by hand from the repo root with
; `dune exec bench/run_fidelity.exe`, never wired into `dune test`.

(executable
 (name run_fidelity)
 (modules run_fidelity)
 (libraries bench tfl tfl_verify translate yojson lwt lwt.unix))

; The 4.6 real-text sample. Implements data/fidelity/real/PROTOCOL.md exactly;
; deterministic, no network — reads the gitignored raw XML in data/raw/ and
; writes the committed sample. Run by hand from the repo root.

(executable
 (name sample_real)
 (modules sample_real)
 (libraries bench))

; The 4.6 definitional sample (PROTOCOL-2): same pipeline, genre selected at the
; section level. Deterministic, no network.

(executable
 (name sample_defs)
 (modules sample_defs)
 (libraries bench))

; Regenerates every number in docs/coverage-report-2026-08-02.md from the
; committed labels. Committed labels with no committed derivation is a quiet
; trap: edit one label and the report goes stale silently.

(executable
 (name coverage_stats)
 (modules coverage_stats)
 (libraries yojson))
