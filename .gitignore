_build/
.env

# Local spend ledger (tokens/costs/ids, never credentials) — a growing
# machine log, not repo material.
data/usage.jsonl

# Third-party benchmark corpora carry their own licences and must never enter
# this MIT repo's history (CLAUDE.md; 2026-08-01 audit). Our own authored data
# — data/policybench/ — is deliberately NOT ignored.
data/raw/
data/results/
data/eval/

# Cached model replies (4.3). Model output, not repo material — and the cache
# is keyed by a digest of the exact request, so it is reproducible by re-running
# rather than something history needs to carry.
data/cache/
