_build/

# Dune regenerates this root package manifest for @install; the authoritative
# package contract lives in dune-project and the generated opam files.
/*.install

# Dotenv files are opaque secret containers in every directory and naming
# variant; none belongs in repository history.
.env
*.env
.env.*
*.env.*

# Local spend ledger (tokens/costs/ids, never credentials) — a growing
# machine log, not repo material.
data/usage.jsonl

# Third-party benchmark corpora carry their own licences and must never enter
# this MIT repo's history (CLAUDE.md; 2026-08-01 audit). Our own authored data
# — data/policybench/ — is deliberately NOT ignored.
data/raw/
data/results/
data/eval/

# Cached model replies (4.3). Model output, not repo material — and the cache
# is keyed by a digest of the exact request, so it is reproducible by re-running
# rather than something history needs to carry.
data/cache/

# Graphify's durable graph, report, manifest, labels, and work memory are
# repository artifacts. Rebuild caches, dated safety snapshots, and the local
# interpreter pointer are machine-specific/generated and stay untracked.
graphify-out/cache/
graphify-out/20??-??-??/
graphify-out/.graphify_python
