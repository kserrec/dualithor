 (libraries tfl test_support qcheck-core qcheck-core.runner))

(test
 (name test_relational)
 (modules test_relational)
 (libraries tfl test_support qcheck-core qcheck-core.runner))

(test
 (name test_program)
 (modules test_program)
 (libraries tfl test_support qcheck-core qcheck-core.runner))

; The differential gate needs Node ≥18 (a dev-time requirement per PLAN) and
; the frozen JS reference; the deps are copied into _build so the test can
; spawn ../engine/shim.js from its own directory.

(test
 (name test_differential)
 (modules test_differential)
 (libraries tfl test_support qcheck-core qcheck-core.runner yojson)
 (deps
  ../engine/tfl.js
  ../engine/tfl.test.js
  ../engine/oracle.js
  ../engine/shim.js))

; The oracle port (1.10) compares against engine/oracle.js through the same
; shim, so it carries the same Node-side deps.

(test
 (name test_semantics)
 (modules test_semantics)
 (libraries tfl test_support qcheck-core qcheck-core.runner yojson)
 (deps ../engine/tfl.js ../engine/oracle.js ../engine/shim.js))

(test
 (name test_numerical)
