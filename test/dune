; Modules shared by the test executables (generators, differential-harness
; plumbing) live in one unwrapped library — dune forbids a module in two
; stanzas.

(library
 (name test_support)
 (wrapped false)
 (modules gen ast_json result_json shim_client harness semantics)
 (libraries tfl qcheck-core yojson unix))

(test
 (name test_tfl)
 (modules test_tfl)
 (libraries tfl test_support qcheck-core qcheck-core.runner))

(test
 (name test_notation)
 (modules test_notation)
 (libraries tfl test_support qcheck-core qcheck-core.runner))

(test
 (name test_infer)
 (modules test_infer)
 (libraries tfl test_support qcheck-core qcheck-core.runner))

(test
 (name test_decide)
