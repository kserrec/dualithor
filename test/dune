; Modules shared by the test executables (generators, differential-harness
; plumbing) live in one unwrapped library — dune forbids a module in two
; stanzas.
(library
 (name test_support)
 (wrapped false)
 (modules gen ast_json shim_client)
 (libraries tfl qcheck-core yojson unix))

(test
 (name test_tfl)
 (modules test_tfl)
 (libraries tfl test_support qcheck-core qcheck-core.runner))

(test
 (name test_notation)
 (modules test_notation)
 (libraries tfl test_support qcheck-core qcheck-core.runner))

(test
 (name test_infer)
 (modules test_infer)
 (libraries tfl test_support qcheck-core qcheck-core.runner))

; The differential gate needs Node ≥18 (a dev-time requirement per PLAN) and
; the frozen JS reference; the deps are copied into _build so the test can
; spawn ../engine/shim.js from its own directory.
(test
 (name test_differential)
 (modules test_differential)
 (libraries tfl test_support qcheck-core qcheck-core.runner yojson)
 (deps ../engine/tfl.js ../engine/tfl.test.js ../engine/shim.js))
